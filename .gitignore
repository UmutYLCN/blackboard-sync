# Local environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/

# Never commit sessions, cookies, browser profiles, sync state or course material.
# (The tool stores these outside the repository by default; these entries are a safety net.)
.bbsync/
session.json
browser-profile/
inapp-profile/
state.json
last-run.json
*.partial
Okul/
University/

# Wrangler local state
.wrangler/

# Optional Google Calendar local state and downloaded OAuth credentials
google-token.json
google-calendar.json
google-calendar-events.json
google-calendar-target.json
google-calendar.lock
client_secret*.json
