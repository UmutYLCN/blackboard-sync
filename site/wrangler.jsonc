{
  "name": "blackboard-sync",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only the short download links and the video (byte ranges) run the Worker; every other path is static.
    "run_worker_first": ["/mac", "/mac/", "/windows", "/windows/", "/assets/*.mp4"]
  },
  "vars": {
    "RELEASE_API": "https://api.github.com/repos/UmutYLCN/blackboard-sync/releases/latest",
    "RELEASES_PAGE": "https://github.com/UmutYLCN/blackboard-sync/releases/latest"
  }
}
