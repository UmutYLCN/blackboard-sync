<?xml version="1.0" encoding="utf-8"?>
<!-- MSIX manifest of the Windows app; packaging/msix/make_layout.py fills in the
     $${...} values (identity.toml and the app version). A full-trust desktop app:
     the PyInstaller build runs unchanged, with package identity. -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 uap5 rescap">

  <Identity Name="${name}" Publisher="${publisher}" Version="${version}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>${display_name}</DisplayName>
    <PublisherDisplayName>${publisher_display_name}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- 1809: the oldest Windows 10 that tells a packaged desktop app how it was
       started (AppInstance.GetActivatedEventArgs, see windows/autostart.py). -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="tr-TR" />
  </Resources>

  <Applications>
    <Application Id="BlackboardSync" Executable="Blackboard Sync.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="${display_name}"
        Description="Blackboard ders içeriklerini bilgisayarınızdaki klasörlere eşitler."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Toast clicks open this packaged app, without HKCU protocol writes
             or the Setup copy's blackboard-sync://update association. -->
        <uap3:Extension Category="windows.protocol" Executable="Blackboard Sync.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:Protocol Name="blackboard-sync-store" Parameters="--store-notification">
            <uap:DisplayName>${display_name}</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>
        <!-- Start at login. Off until the app turns it on (its settings), as the
             installer build's HKCU Run value; TaskId is autostart.TASK_ID. -->
        <uap5:Extension Category="windows.startupTask" Executable="Blackboard Sync.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="BlackboardSyncStartup" Enabled="false" DisplayName="${display_name}" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
