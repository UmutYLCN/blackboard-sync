<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Playwright's Node.js driver (Contents/Frameworks/playwright/driver/node).
     V8 compiles JavaScript at run time into MAP_JIT memory, which the hardened
     runtime only allows with allow-jit; see docs/SIGNING.md. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
