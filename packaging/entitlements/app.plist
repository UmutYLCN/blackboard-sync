<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's own process (Python, PyObjC, WebKit) runs under the hardened
     runtime with one exception: sending Apple events, so that Home's AI card can
     open a window in iTerm2 (blackboard_sync.ai_launcher). macOS still asks the
     student first. See docs/SIGNING.md. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
